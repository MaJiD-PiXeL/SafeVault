{
	admin off
}

{$VAULT_HOST} {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=3600"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	@backend path /api /api/* /admin /admin/*
	handle @backend {
		header Cache-Control "no-store"
		reverse_proxy unix//run/safevault/gunicorn.sock {
			header_up X-SafeVault-Client-IP {remote_host}
		}
	}

	handle_path /static/* {
		root * /srv/admin
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv/vault
		header Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@entry not path /assets/*
		header @entry Cache-Control "no-cache"
		file_server
	}
}

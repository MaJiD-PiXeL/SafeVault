DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_NAME=safevault
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Production email uses SMTP with STARTTLS. Leave credentials in your secret store.
DJANGO_ACCOUNT_LINK_ORIGIN=http://127.0.0.1:5173
DJANGO_FROM_EMAIL="SafeVault <no-reply@localhost>"
DJANGO_SMTP_HOST=
DJANGO_SMTP_PORT=587
DJANGO_SMTP_USERNAME=
DJANGO_SMTP_PASSWORD=
# Enable only after validating HTTPS on all affected subdomains.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
